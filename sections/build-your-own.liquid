{%- comment -%}
  Build Your Own 12-can box.
  Commerce model: ONE Shopify product at a fixed price (₹660). The customer's chosen
  mix rides along as a line item property, because single cans are not sold separately.

  Products resolve AUTOMATICALLY by handle, so the section works with no theme-editor
  wiring. A product picker can still override the handle if the merchant wants.
{%- endcomment -%}

{%- assign byo = section.settings.byo_product -%}
{%- unless byo.id -%}
  {%- assign byo = all_products[section.settings.byo_handle] -%}
{%- endunless -%}

{%- assign a = section.settings.p1 -%}
{%- unless a.id -%}{%- assign a = all_products[section.settings.h1] -%}{%- endunless -%}
{%- assign b = section.settings.p2 -%}
{%- unless b.id -%}{%- assign b = all_products[section.settings.h2] -%}{%- endunless -%}
{%- assign c = section.settings.p3 -%}
{%- unless c.id -%}{%- assign c = all_products[section.settings.h3] -%}{%- endunless -%}

{%- assign name1 = section.settings.n1 | default: a.title -%}
{%- assign name2 = section.settings.n2 | default: b.title -%}
{%- assign name3 = section.settings.n3 | default: c.title -%}

<section class="section byo" id="build">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="h2 display">{{ section.settings.title }}</h2>
      <p class="lede">{{ section.settings.lede }}</p>
    </div>

    {%- render 'byo-builder',
        byo: byo,
        max: section.settings.pack_size,
        p1: a, p2: b, p3: c,
        n1: name1, n2: name2, n3: name3,
        note: section.settings.note -%}
  </div>
</section>

{% schema %}
{
  "name": "Build your own box",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Mix & match" },
    { "type": "text", "id": "title", "label": "Title", "default": "Build your own box. Mix all three." },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Pick 12 cans across Green Apple, Mojito and Watermelon — your valley, your way." },
    { "type": "header", "content": "Commerce" },
    { "type": "text", "id": "byo_handle", "label": "Build-your-own product handle", "default": "build-your-own", "info": "Resolved automatically. Only set the picker below if you want to override it." },
    { "type": "product", "id": "byo_product", "label": "Override: build-your-own product" },
    { "type": "range", "id": "pack_size", "label": "Cans per box", "min": 6, "max": 24, "step": 6, "default": 12 },
    { "type": "header", "content": "Flavour rows" },
    { "type": "text", "id": "h1", "label": "Flavour 1 handle", "default": "green-apple" },
    { "type": "text", "id": "n1", "label": "Flavour 1 name" },
    { "type": "product", "id": "p1", "label": "Override: flavour 1 product" },
    { "type": "text", "id": "h2", "label": "Flavour 2 handle", "default": "mojito" },
    { "type": "text", "id": "n2", "label": "Flavour 2 name" },
    { "type": "product", "id": "p2", "label": "Override: flavour 2 product" },
    { "type": "text", "id": "h3", "label": "Flavour 3 handle", "default": "watermelon" },
    { "type": "text", "id": "n3", "label": "Flavour 3 name" },
    { "type": "product", "id": "p3", "label": "Override: flavour 3 product" },
    { "type": "header", "content": "Footnote" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "12 cans, mix & match — best value at ₹55 a can. Ships across India." }
  ],
  "presets": [{ "name": "Build your own box" }]
}
{% endschema %}
