<section class="section">
  <div class="container">
    <div class="section__head">
      <p class="eyebrow">Kashmir's own soda</p>
      <h1 class="h1 display">{{ collection.title | default: 'Products' }}</h1>
      {%- if collection.description != blank -%}
        <div class="lede">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size > 0 -%}
        <div class="coll__grid">
          {%- for p in collection.products -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <article class="flavor-card reveal">
              <a class="flavor-card__can" href="{{ p.url }}">
                {%- if p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}"
                       width="600" height="{{ 600 | divided_by: p.featured_image.aspect_ratio | round }}" loading="lazy">
                {%- endif -%}
              </a>
              <h3 class="flavor-card__name">{{ p.title }}</h3>
              <div class="pdp__price">{{ p.price | money }}</div>
              <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-product-form>
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn btn--accent btn--block" {% unless v.available %}disabled{% endunless %}>
                  {% if v.available %}Add{% else %}Sold out{% endif %}
                </button>
              </form>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="text-center mt-2">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- else -%}
        <p class="lede text-center">Nothing here yet — the valley is restocking.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
