<section class="section">
  <div class="container">
    <div class="section__head">
      <h1 class="h1 display">{{ 'general.search.title' | t }}</h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="news__form">
      <label class="is-hidden" for="SearchInput">{{ 'general.search.title' | t }}</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="btn btn--saffron">{{ 'general.search.title' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="coll__grid mt-2">
          {%- for item in search.results -%}
            <article class="flavor-card">
              {%- if item.featured_image -%}
                <a class="flavor-card__can" href="{{ item.url }}">
                  <img src="{{ item.featured_image | image_url: width: 500 }}" alt="{{ item.title | escape }}"
                       width="500" height="{{ 500 | divided_by: item.featured_image.aspect_ratio | round }}" loading="lazy">
                </a>
              {%- endif -%}
              <h3 class="flavor-card__name"><a href="{{ item.url }}">{{ item.title }}</a></h3>
              {%- if item.price -%}<div class="pdp__price">{{ item.price | money }}</div>{%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="lede">{{ 'general.search.no_results' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
