{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }} gift card</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <section class="section text-center">
      <div class="container" style="max-width:520px">
        <p class="eyebrow">{{ shop.name }}</p>
        <h1 class="h1 display">Your gift card</h1>
        <div class="pdp__price">{{ gift_card.balance | money }}</div>
        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="muted">Originally {{ gift_card.initial_value | money }}</p>
        {%- endif -%}

        <div class="feature-card mt-2">
          <p class="kicker">Gift card code</p>
          <p class="h3">{{ gift_card.code | format_code }}</p>
        </div>

        {%- if gift_card.expired -%}
          <p class="muted mt-2">Expired on {{ gift_card.expires_on | date: '%d %B %Y' }}</p>
        {%- elsif gift_card.expires_on -%}
          <p class="muted mt-2">Expires {{ gift_card.expires_on | date: '%d %B %Y' }}</p>
        {%- endif -%}

        <p class="mt-2"><a class="btn btn--saffron btn--lg" href="{{ shop.url }}">Shop BlackPeak</a></p>
      </div>
    </section>
  </body>
</html>
