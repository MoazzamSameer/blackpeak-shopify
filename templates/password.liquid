<section class="section text-center">
  <div class="container" style="max-width:560px">
    <p class="eyebrow">Kashmir's own soda</p>
    <h1 class="h1 display">Opening soon.</h1>
    <p class="lede">{{ shop.password_message | default: 'Bold flavour, bold fizz. The valley is nearly ready.' }}</p>

    {%- form 'storefront_password', class: 'news__form' -%}
      <label class="is-hidden" for="Password">Password</label>
      <input id="Password" type="password" name="password" placeholder="Enter store password" required>
      <button type="submit" class="btn btn--saffron btn--lg">Enter</button>
      {%- if form.errors -%}
        <p class="muted mt-2">{{ form.errors.messages.form }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
